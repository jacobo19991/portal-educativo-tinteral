# =============================================
# VARIABLES DE ENTORNO — Portal Educativo
# Configura estas variables en Vercel:
# Settings → Environment Variables
# =============================================

# Supabase (Autenticación administrativa, roles y hash de PIN)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PIN docente fallback si no se consulta la base de datos
DOCENTES_PIN=

# URL base permitida para CORS (tu dominio de Vercel)
ALLOWED_ORIGINS=https://portal-educativo-tinteral.vercel.app

# Google Drive API (opcional)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
