# =============================================
# VARIABLES DE ENTORNO — Portal Educativo
# Configura estas variables en Vercel:
# Settings → Environment Variables
# =============================================

# PIN de acceso para las Herramientas Docentes (Abrir Drive, Manual de uso)
# Para cambiar el PIN: edita este valor en Vercel y haz push a main
DOCENTES_PIN=tu-pin-secreto-aqui

# URL base permitida para CORS (tu dominio de Vercel)
ALLOWED_ORIGINS=https://portal-educativo-tinteral.vercel.app

# Google Drive API (si usas el endpoint /api/drive directamente)
# No requerido si usas Apps Script como fuente principal
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
